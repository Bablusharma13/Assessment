# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on (Render sets this automatically)
PORT=5000

# Local: mongodb://127.0.0.1:27017/task-manager
# Production: your MongoDB Atlas connection string
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
# node -p "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=

# Frontend origin allowed by CORS (no trailing slash)
# Local: http://localhost:5173
FRONTEND_URL=
